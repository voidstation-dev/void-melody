{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoidMelody",
  "version": "0.3.3",
  "identifier": "com.voidstation.melody",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VoidMelody",
        "width": 1300,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "bin/melody-api",
      "bin/ffmpeg"
    ],
    "resources": [
      "bin/Voice.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RDBGRjU2MjEyNTA3RUUKUldUdUJ5VWhWdi9ReC80NUw0UGQyTjA1THVxV3M5em80ZzNxN1pOOVFzODk5OGxUL0FGODRoUG8K",
      "endpoints": [
        "https://github.com/voidstation-dev/void-melody/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
